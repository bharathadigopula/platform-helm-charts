{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {"type": "string"},
    "replicas": {"type": "integer", "minimum": 0, "maximum": 10},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "runtimeSecret": {"$ref": "#/definitions/optionalName"},
    "registrySecret": {"$ref": "#/definitions/optionalName"},
    "runAsUser": {"type": "integer", "minimum": 1},
    "runAsGroup": {"type": "integer", "minimum": 1},
    "readinessPath": {"type": "string", "pattern": "^/[^\\r\\n]*$"},
    "resources": {"$ref": "#/definitions/resources"},
    "migration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "databaseUrlKey": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      },
      "required": ["enabled", "image", "databaseUrlKey"]
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}, "image": {"type": "string"},
        "existingSecret": {"$ref": "#/definitions/optionalName"},
        "storageClass": {"$ref": "#/definitions/name"},
        "storage": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "username": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "resources": {"$ref": "#/definitions/resources"}
      },
      "required": ["enabled", "image", "existingSecret", "storageClass", "storage", "runAsUser", "runAsGroup", "name", "username", "resources"]
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"$ref": "#/definitions/name"},
        "hostname": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "tlsSecret": {"$ref": "#/definitions/optionalName"}
      },
      "required": ["enabled", "className", "hostname", "tlsSecret"]
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "ingressNamespace": {"$ref": "#/definitions/name"},
        "ingressPodLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "publicEgressPorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      },
      "required": ["enabled", "ingressNamespace", "ingressPodLabels", "publicEgressPorts"]
    }
  },
  "required": ["image", "replicas", "port", "runtimeSecret", "registrySecret", "runAsUser", "runAsGroup", "readinessPath", "resources", "migration", "database", "ingress", "networkPolicy"],
  "definitions": {
    "name": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "optionalName": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"},
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      },
      "required": ["requests", "limits"]
    },
    "resourcePair": {
      "type": "object", "additionalProperties": false,
      "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}},
      "required": ["cpu", "memory"]
    }
  }
}