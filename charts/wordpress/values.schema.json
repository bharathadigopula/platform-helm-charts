{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["wordpress", "nginx", "mariadb", "backup"],
  "properties": {
    "wordpress": {
      "type": "object",
      "required": ["configuration", "php", "persistence"],
      "properties": {
        "configuration": {
          "type": "object",
          "required": ["memoryLimit", "maxMemoryLimit", "autosaveInterval", "postRevisions", "emptyTrashDays"],
          "properties": {
            "memoryLimit": {"type": "string", "pattern": "^[1-9][0-9]*M$"},
            "maxMemoryLimit": {"type": "string", "pattern": "^[1-9][0-9]*M$"},
            "autosaveInterval": {"type": "integer", "minimum": 1},
            "postRevisions": {"type": "integer", "minimum": 0},
            "emptyTrashDays": {"type": "integer", "minimum": 0}
          }
        },
        "php": {
          "type": "object",
          "required": ["maxExecutionTime", "maxInputTime", "maxInputVars", "memoryLimit", "opcacheInternedStringsBuffer", "opcacheMaxAcceleratedFiles", "opcacheMemoryConsumption", "postMaxSize", "uploadMaxFilesize"],
          "properties": {
            "maxExecutionTime": {"type": "integer", "minimum": 1},
            "maxInputTime": {"type": "integer", "minimum": 1},
            "maxInputVars": {"type": "integer", "minimum": 1},
            "memoryLimit": {"type": "string", "pattern": "^[1-9][0-9]*M$"},
            "opcacheInternedStringsBuffer": {"type": "integer", "minimum": 1},
            "opcacheMaxAcceleratedFiles": {"type": "integer", "minimum": 1},
            "opcacheMemoryConsumption": {"type": "integer", "minimum": 1},
            "postMaxSize": {"type": "string", "pattern": "^[1-9][0-9]*M$"},
            "uploadMaxFilesize": {"type": "string", "pattern": "^[1-9][0-9]*M$"}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["storageClass", "size", "coreSize", "extensionsSize"],
          "properties": {
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"},
            "coreSize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"},
            "extensionsSize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
          }
        }
      }
    },
    "nginx": {
      "type": "object",
      "required": ["clientMaxBodySize"],
      "properties": {
        "clientMaxBodySize": {"type": "string", "pattern": "^[1-9][0-9]*m$"}
      }
    },
    "mariadb": {
      "type": "object",
      "required": ["persistence"],
      "properties": {
        "persistence": {
          "type": "object",
          "required": ["storageClass", "size"],
          "properties": {
            "storageClass": {"type": "string"},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "required": ["enabled", "tag", "schedule", "retention", "restore", "verify"],
      "properties": {
        "enabled": {"type": "boolean"},
        "tag": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
        "schedule": {"type": "string", "minLength": 1},
        "retention": {
          "type": "object",
          "required": ["daily", "weekly", "monthly"],
          "properties": {
            "daily": {"type": "integer", "minimum": 1},
            "weekly": {"type": "integer", "minimum": 1},
            "monthly": {"type": "integer", "minimum": 1}
          }
        },
        "restore": {
          "type": "object",
          "required": ["enabled", "id", "snapshot"],
          "properties": {
            "enabled": {"type": "boolean"},
            "id": {"type": "string", "pattern": "^[a-z0-9-]*$"},
            "snapshot": {"type": "string", "minLength": 1}
          }
        },
        "verify": {
          "type": "object",
          "required": ["enabled", "id", "snapshot"],
          "properties": {
            "enabled": {"type": "boolean"},
            "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "snapshot": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
